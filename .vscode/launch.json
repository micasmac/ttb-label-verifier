{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TTB Label Verifier",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "jinja": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"]
    }
  ]
}
